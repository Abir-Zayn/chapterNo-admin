# Copy to .env and run with:
# flutter run -d chrome --dart-define-from-file=.env
# NEVER put service_role or sb_secret_ keys in this file.
# SUPABASE_PROXY_URL points at the Cloudflare Worker proxy (cloudflare-worker/),
# which holds the real Supabase credentials server-side and swaps this
# placeholder key for the real publishable key on every request.
SUPABASE_PROXY_URL=https://your-worker-name.your-subdomain.workers.dev
SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder_swapped_by_worker
